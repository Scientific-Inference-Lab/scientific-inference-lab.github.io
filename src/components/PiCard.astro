---
import { ArrowRight, ArrowUpRight } from '@lucide/svelte';
import { getProfileLinks } from '../lib/data/lab';
import type { site as siteData } from '../lib/data/lab';
import type { loadContent } from '../lib/content';

interface Props {
  pi: Awaited<ReturnType<typeof loadContent>>['pi'];
  site: typeof siteData;
  portrait: { src: string; width: number; height: number; alt: string; avif?: string; webp?: string; srcset?: string; sizes?: string };
}
const { pi, site, portrait } = Astro.props;
const profiles = getProfileLinks(pi.links);
---
<section class="wrap pi-section" aria-labelledby="pi-card-name">
  <div id="pi" class="pi-card">
    <div class="pi-photo min-w-0">
      <picture>
        {portrait.avif && <source type="image/avif" srcset={portrait.avif} sizes={portrait.sizes} />}
        {portrait.webp && <source type="image/webp" srcset={portrait.webp} sizes={portrait.sizes} />}
        <img src={portrait.src} srcset={portrait.srcset} sizes={portrait.sizes} width={portrait.width} height={portrait.height} alt={portrait.alt} loading="eager" fetchpriority="high" class="pi-portrait block h-auto w-full" />
      </picture>
    </div>
    <div class="pi-text min-w-0">
      {/* PI 2026-10-02 (second turn): a static name and one visible profile action on its row; wraps under the name in a narrow column. */}
      <div class="pi-name-row">
        <h2 id="pi-card-name" class="pi-name font-display font-bold">{pi.name}</h2>
        <a href="/people/yongkyung-oh/" class="button-secondary button-compact" aria-label={`Full profile of ${pi.name}`} data-profile-action>Full profile<ArrowRight size={16} aria-hidden="true" /></a>
      </div>
      <p class="mt-2 text-lg font-medium text-ink">{pi.role}</p>
      <p class="mt-1 leading-relaxed text-body">{site.affiliation}</p>
      <p class="pi-short mt-3 leading-relaxed text-body">{pi.shortBio}</p>
      <ul class="pi-links" aria-label="YongKyung Oh's profiles">
        {profiles.map(profile => <li><a href={profile.href} class="text-link inline-flex min-h-11 items-center gap-2">{profile.label}<ArrowUpRight size={16} aria-hidden="true" /></a></li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .pi-section { container: pi-section / inline-size; padding-top: 2.5rem; }
  .pi-card { display: grid; grid-template-columns: minmax(0,1fr); gap: 1.25rem; align-items: start; }
  .pi-photo { width: min(12rem, 100%); }
  /* The name shrinks with its own column (rem container queries follow enlarged
     text, lesson 18) so "YongKyung" never breaks inside the word. */
  /* One measure on the text column (audit 63 D2): the section width keeps the
     affiliation on one line at desktop and the short bio at a readable length. */
  .pi-text { container: pi-text / inline-size; max-width: var(--measure-section); }
  .pi-name { font-size: 1.75rem; line-height: 1.2; }
  @container pi-text (max-width: 12rem) { .pi-name { font-size: 1.375rem; } }
  @container pi-text (max-width: 9rem) { .pi-name { font-size: 1.125rem; } }
  @container pi-text (max-width: 7rem) { .pi-name { font-size: 1rem; } }
  .pi-name-row { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; }
  .pi-name-row .pi-name { min-width: 0; }
  .pi-links { display: flex; flex-wrap: wrap; gap: .25rem 1.5rem; margin-top: .5rem; }
  @container pi-section (min-width: 34rem) {
    .pi-card { grid-template-columns: 12rem minmax(0,1fr); column-gap: 2.5rem; }
    .pi-name { font-size: 2.25rem; }
  }
  @media (max-width: 47.99rem) { .pi-section { padding-top: 2rem; } }
</style>
