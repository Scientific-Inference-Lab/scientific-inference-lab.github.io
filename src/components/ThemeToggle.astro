---
/**
 * Light/dark toggle.
 *
 * Three states are possible: explicit light, explicit dark, and "follow the
 * system" (nothing stored). The button flips between light and dark; clearing
 * the stored value to return to system is not exposed, since the toggle is
 * mainly here so the theme can be checked without changing OS settings.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="grid h-9 w-9 place-items-center rounded-full border border-line text-muted transition-colors hover:border-line-strong hover:text-body"
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
  aria-pressed="false"
>
  {/* Both icons ship; CSS shows whichever matches the active theme. */}
  <svg class="theme-icon-light h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0 2a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-18a1 1 0 0 1 1 1v2a1 1 0 1 1-2 0V2a1 1 0 0 1 1-1zm0 18a1 1 0 0 1 1 1v2a1 1 0 1 1-2 0v-2a1 1 0 0 1 1-1zM1 12a1 1 0 0 1 1-1h2a1 1 0 1 1 0 2H2a1 1 0 0 1-1-1zm18 0a1 1 0 0 1 1-1h2a1 1 0 1 1 0 2h-2a1 1 0 0 1-1-1zM4.22 4.22a1 1 0 0 1 1.41 0l1.42 1.42a1 1 0 0 1-1.41 1.41L4.22 5.63a1 1 0 0 1 0-1.41zm12.73 12.73a1 1 0 0 1 1.41 0l1.42 1.42a1 1 0 0 1-1.42 1.41l-1.41-1.41a1 1 0 0 1 0-1.42zM19.78 4.22a1 1 0 0 1 0 1.41l-1.41 1.42a1 1 0 1 1-1.42-1.41l1.42-1.42a1 1 0 0 1 1.41 0zM7.05 16.95a1 1 0 0 1 0 1.42l-1.42 1.41a1 1 0 0 1-1.41-1.41l1.41-1.42a1 1 0 0 1 1.42 0z"/>
  </svg>
  <svg class="theme-icon-dark h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M21.64 13a1 1 0 0 0-1.05-.14 8 8 0 0 1-10.45-10.45 1 1 0 0 0-1.2-1.32A10 10 0 1 0 22 14.05a1 1 0 0 0-.36-1.05z"/>
  </svg>
</button>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    var root = document.documentElement;

    function current() {
      if (root.dataset.theme) return root.dataset.theme;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    function sync() {
      btn.setAttribute('aria-pressed', current() === 'dark' ? 'true' : 'false');
    }
    btn.addEventListener('click', function () {
      var next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch (e) {
        /* storage blocked: the choice still applies for this page view */
      }
      sync();
    });
    sync();
  })();
</script>
