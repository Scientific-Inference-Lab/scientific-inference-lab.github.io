---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lede?: string;
  class?: string;
}
const { id, eyebrow, title, lede, class: className = '' } = Astro.props;
---

<section id={id} class={`px-6 py-20 md:py-24 ${className}`}>
  <div class="mx-auto max-w-6xl">
    <header class="reveal">
      <p class="text-xs font-semibold tracking-[0.18em] text-brand uppercase">
        {eyebrow}
      </p>
      <h2 class="mt-3 text-3xl font-semibold tracking-[-0.02em] text-balance md:text-4xl">
        {title}
      </h2>
      {lede && (
        <p class="mt-4 max-w-2xl leading-relaxed text-muted text-pretty">{lede}</p>
      )}
    </header>
    <div class="mt-10">
      <slot />
    </div>
  </div>
</section>
