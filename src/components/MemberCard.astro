---
import { ArrowRight, ArrowUpRight, User } from '@lucide/svelte';

interface Props {
  member: { id: string; name: string; role: string; since?: string; photo?: string; summary?: string; placeholder?: boolean; contact?: string; profile?: string;
    links?: { personal?: string; github?: string; scholar?: string; linkedin?: string } };
}
const { member } = Astro.props;
const labels = { personal: 'Personal Website', scholar: 'Google Scholar', github: 'GitHub', linkedin: 'LinkedIn' } as const;
const links = (Object.keys(labels) as (keyof typeof labels)[]).flatMap(key => member.links?.[key] ? [{ label: labels[key], href: member.links[key]! }] : []);
---
<li class:list={['member-card', { 'is-placeholder': member.placeholder }]} data-member={member.id} data-placeholder={member.placeholder ? '' : undefined}>
  {member.photo && <img src={member.photo} alt={`Portrait of ${member.name}`} width="96" height="96" loading="lazy" class="member-photo" />}
  {!member.photo && member.placeholder && <div class="member-photo member-photo-empty" aria-hidden="true"><User size={36} /></div>}
  <div class="member-text min-w-0">
    <div class="member-name-row">
      <h3 class="member-name font-bold">{member.name}</h3>
      {member.profile && <a href={member.profile} class="button-secondary button-compact" aria-label={`Full profile of ${member.name}`} data-profile-action>Full profile<ArrowRight size={16} aria-hidden="true" /></a>}
    </div>
    {!member.placeholder && <p class="member-meta">{member.since ? `${member.role} · ${member.since}` : member.role}</p>}
    {member.summary && <p class="member-summary">{member.summary}</p>}
    {member.contact && <a href={member.contact} class="text-link member-contact inline-flex min-h-11 items-center gap-2">Contact<ArrowRight size={16} aria-hidden="true" /></a>}
    {links.length > 0 && (
      <ul class="member-links" aria-label={`${member.name}'s profiles`}>
        {links.map(link => <li><a href={link.href} class="text-link inline-flex min-h-11 items-center gap-2">{link.label}<ArrowUpRight size={16} aria-hidden="true" /></a></li>)}
      </ul>
    )}
  </div>
</li>

<style>
  .member-card { container: member / inline-size; display: grid; grid-template-columns: minmax(0,1fr); gap: 1rem; padding-block: 1.5rem; border-top: 1px solid var(--color-line); }
  .member-photo { width: 6rem; height: 6rem; object-fit: cover; }
  @container member (min-width: 28rem) { .member-card { grid-template-columns: 6rem minmax(0,1fr); column-gap: 1.5rem; align-items: start; } }
  .member-photo-empty { display: grid; place-items: center; border: 1px dashed var(--color-line); color: var(--color-muted); }
  .member-contact { margin-top: .25rem; }
  .member-name-row { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; }
  .member-name { min-width: 0; font-size: 1.25rem; line-height: 1.3; }
  .member-meta { margin-top: .25rem; color: var(--color-muted); }
  .member-text { max-width: var(--measure-prose); }
  .member-summary { margin-top: .5rem; line-height: 1.6; color: var(--color-body); }
  .member-links { display: flex; flex-wrap: wrap; gap: .25rem 1.5rem; margin-top: .25rem; }
</style>
