---
import Wordmark from '../assets/wordmark.svg';
import ThemeToggle from './ThemeToggle.astro';
import { site, nav, content } from '../config';
---

<header
  class="fixed inset-x-0 top-0 z-40 border-b border-line/60 bg-page/80 backdrop-blur-md"
>
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-6"
    aria-label={content.header.navigationLabel}
  >
    {/*
      The wordmark is the logo: the lab name set in Space Grotesk and converted
      to vector outlines, so it renders identically whether or not the webfont
      loads. Inlined (not <img>) so it inherits currentColor and needs no extra
      request. aria-label carries the name; the <svg> title is hidden from the
      a11y tree to avoid a duplicate announcement.
    */}
    <a
      href="#top"
      aria-label={site.name}
      class="block w-[8.5rem] shrink-0 text-body transition-colors hover:text-brand-hover min-[360px]:w-[11.5rem] sm:w-[13rem]"
    >
      <Wordmark aria-hidden="true" class="h-auto w-full" />
    </a>

    <div class="flex items-center gap-4 md:gap-8">
      <ul class="hidden items-center gap-8 md:flex">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-sm text-muted transition-colors hover:text-body"
            >
              {item.label}
            </a>
          </li>
        ))
        }
      </ul>

      {/* Mobile: anchor list collapses to a single jump link rather than a
           JS drawer: five anchors don't justify the interaction cost. */}
      <a
        href="#research"
        class="hidden text-sm font-medium text-brand transition-colors hover:text-brand-hover min-[360px]:block md:hidden"
      >
        {content.header.explore}
      </a>

      <ThemeToggle />
    </div>
  </nav>
</header>
