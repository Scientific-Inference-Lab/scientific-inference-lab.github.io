---
import Section from './Section.astro';
import { news, content } from '../config';

const fullDateFormat = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});

const monthFormat = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  timeZone: 'UTC',
});

const formatDate = (date: string) => {
  const isMonthOnly = date.length === 7;
  const normalized = isMonthOnly ? `${date}-01` : date;
  const formatter = isMonthOnly ? monthFormat : fullDateFormat;

  return formatter.format(new Date(`${normalized}T00:00:00Z`));
};
---

<Section
  id="news"
  eyebrow={content.news.eyebrow}
  title={content.news.title}
>
  <ul class="space-y-px overflow-hidden rounded-2xl border border-line bg-line">
    {
      news.map((item) => (
        <li
          class="reveal flex flex-col gap-1 bg-surface px-6 py-5 sm:flex-row sm:items-baseline sm:gap-8"
        >
          <time
            datetime={item.date}
            class="font-serif text-sm text-subtle tabular-nums sm:w-28 sm:shrink-0"
          >
            {formatDate(item.date)}
          </time>
          <span class="text-body text-pretty">{item.text}</span>
        </li>
      ))
    }
  </ul>
</Section>
