---
import { ArrowRight, ArrowUpRight, Mail, MapPin, Phone } from '@lucide/svelte';
import type { pi as personData, site as siteData, joinUs as inquiryData } from '../lib/data/lab';
import type { responsiveImage } from '../lib/media';
import CopyEmail from './CopyEmail.svelte';

interface Props {
  pi: typeof personData;
  site: typeof siteData;
  joinUs: typeof inquiryData;
  university: Awaited<ReturnType<typeof responsiveImage>>;
}
const { pi, site, joinUs, university } = Astro.props;
const [emailLocal, emailDomain] = pi.email.split('@');
---
<section class="contact-primary" aria-labelledby="inquiries-heading">
  <div class="wrap contact-layout grid items-start gap-10">
    <div class="contact-identity min-w-0">
      <a href={`mailto:${pi.email}`} class="contact-email inline-block font-display font-semibold text-action"><span>{emailLocal}</span><wbr /><span>@{emailDomain}</span></a>
      <div class="contact-person mt-3 flex flex-wrap items-baseline gap-x-2 gap-y-1">
        <h2 id="inquiries-heading" class="font-semibold">{pi.name}</h2>
        <p class="text-muted">Principal Investigator</p>
      </div>
      <div class="contact-actions mt-4 grid items-center gap-x-3 gap-y-2">
        <a href={`mailto:${pi.email}`} class="button"><Mail size={18} aria-hidden="true" /><span>Send an email</span></a>
        <CopyEmail email={pi.email} client:load />
      </div>
    </div>
    <div class="contact-opportunities min-w-0">
      <h2 class="text-xl font-bold">Discuss your interests</h2>
      <p class="mt-3 leading-relaxed text-body">{joinUs.body}</p>
      <ul class="inquiry-links mt-4" aria-label="Email inquiry topics">
        <li><a href={`mailto:${pi.email}?subject=${encodeURIComponent('Research opportunities')}`} class="text-link inquiry-link" aria-label="Email about research opportunities">Email about research opportunities<Mail size={17} aria-hidden="true" /></a></li>
        <li><a href={`mailto:${pi.email}?subject=${encodeURIComponent('Research collaboration')}`} class="text-link inquiry-link" aria-label="Email about research collaboration">Email about collaboration<Mail size={17} aria-hidden="true" /></a></li>
      </ul>
      <a href="/research/" class="text-link mt-3 inline-flex min-h-11 items-center gap-2">Explore our research<ArrowRight size={17} aria-hidden="true" /></a>
    </div>
  </div>
</section>

<section class="wrap contact-location grid gap-10 py-10 sm:py-14 md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] md:gap-16" aria-labelledby="location-heading">
  <div class="min-w-0">
    <p class="kicker">Yangsan campus</p>
    <h2 id="location-heading" class="text-3xl font-bold">Location</h2>
    <address class="mt-7 grid gap-6 not-italic">
      <div class="flex gap-4">
        <MapPin size={21} class="mt-1 shrink-0 text-action" aria-hidden="true" />
        <div>
          <p class="text-lg font-semibold">{pi.office}</p>
          <p class="mt-2 max-w-xl leading-relaxed text-body">{pi.address}</p>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <Phone size={21} class="shrink-0 text-action" aria-hidden="true" />
        <a href="tel:+82515106624" class="text-link inline-flex min-h-11 items-center">{pi.phone}</a>
      </div>
    </address>
  </div>
  <div class="min-w-0 md:pt-2">
    <a href={site.universityUrl} class="inline-block max-w-full" aria-label="Pusan National University website">
      <picture>
        {university.avif && <source type="image/avif" srcset={university.avif} sizes={university.sizes} />}
        {university.webp && <source type="image/webp" srcset={university.webp} sizes={university.sizes} />}
        <img src={university.src} srcset={university.srcset} sizes={university.sizes} width={university.width} height={university.height} alt={university.alt} loading="lazy" class="h-auto w-full max-w-80 object-contain" />
      </picture>
    </a>
    <p class="mt-5 max-w-sm leading-relaxed text-body">{site.department}</p>
    <a href={site.universityUrl} class="text-link mt-4 inline-flex min-h-11 items-center gap-2">University website<ArrowUpRight size={17} aria-hidden="true" /></a>
  </div>
</section>

<style>
  .contact-primary { container: contact-panel / inline-size; padding-block: 2.5rem; }
  .contact-identity { container-type: inline-size; }
  .contact-email { max-width: 100%; min-height: 44px; overflow-wrap: normal; font-size: 1.5rem; line-height: 1.4; }
  .contact-email span { white-space: nowrap; }
  .contact-email:hover { text-decoration: underline; text-underline-offset: .15em; }
  .contact-person h2, .contact-person p { font-size: 1rem; line-height: 1.5; }
  .contact-actions { grid-template-columns: minmax(0, max-content) minmax(44px, 1fr); }
  .contact-actions > .button { overflow-wrap: normal; }
  .contact-opportunities { max-width: 42rem; }
  .inquiry-links { display: grid; gap: .25rem; }
  .inquiry-link { justify-content: space-between; width: 100%; min-height: 44px; gap: 1rem; padding-block: .5rem; }
  .contact-location { border-top: 1px solid var(--color-line); }
  @container contact-panel (min-width: 60rem) {
    .contact-layout { grid-template-columns: minmax(0,3fr) minmax(0,2fr); gap: 4rem; }
    .contact-email { font-size: 1.75rem; }
  }
  @container (max-width: 12rem) {
    .contact-email { font-size: 1.125rem; }
    .contact-actions { grid-template-columns: minmax(0,1fr); justify-items: start; }
    .contact-actions > .button { width: 100%; }
  }
  @media (max-width: 47.99rem) { .contact-primary { padding-block: 2rem; } }
</style>
