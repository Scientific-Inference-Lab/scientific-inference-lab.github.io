---
import { ArrowUpRight, Mail } from '@lucide/svelte';
import { getProfileLinks, site } from '../lib/data/lab';
import { loadContent } from '../lib/content';
import university from '../lib/assets/university.svg';
import SiteNavigation from '../components/SiteNavigation.astro';
import { analytics, jsonLd, structuredData, type PageKind } from '../lib/seo';
import '../lib/styles/app.css';
interface Props { title: string; description?: string; image?: string; }
const { title, description = site.intro, image } = Astro.props;
const content = await loadContent();
const { pi } = content;
const [emailLocal, emailDomain] = pi.email.split('@');
const profiles = getProfileLinks(pi.links);
const home = Astro.url.pathname === '/';
const canonical = new URL(Astro.url.pathname, site.url);
const documentTitle = home ? `${site.name} | ${site.institution}` : `${title} | ${site.name}`;
const kinds: Record<string, PageKind> = { '/': 'home', '/research/': 'research', '/publications/': 'publications', '/people/': 'people', '/contact/': 'contact' };
const kind = kinds[Astro.url.pathname];
if (!kind) throw new Error(`No structured-data kind for ${Astro.url.pathname}`);
const imageUrl = image ? new URL(image, site.url).href : undefined;
// GA4 (PI 2026-09-29) runs only on the production host, so local QC, previews
// and dev servers send nothing to Google.
const analyticsLoader = `if (location.hostname === ${JSON.stringify(analytics.hostname)}) {
  window.dataLayer = window.dataLayer || [];
  window.gtag = function () { window.dataLayer.push(arguments); };
  window.gtag('js', new Date());
  window.gtag('config', ${JSON.stringify(analytics.id)});
  const tag = document.createElement('script');
  tag.async = true;
  tag.src = 'https://www.googletagmanager.com/gtag/js?id=${analytics.id}';
  document.head.appendChild(tag);
}`;
const graph = structuredData(kind, { path: Astro.url.pathname, title: documentTitle, description }, content, kind === 'people' ? imageUrl : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} /><link rel="icon" href="data:," />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="author" content={pi.name} />
    <meta property="og:site_name" content={site.name} /><meta property="og:locale" content="en_US" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} /><meta property="og:type" content={kind === 'people' ? 'profile' : 'website'} /><meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:alt" content={pi.photoAlt} />}
    <meta name="twitter:card" content="summary" />
    <script is:inline type="application/ld+json" set:html={jsonLd(graph)} />
    <script is:inline set:html={analyticsLoader} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteNavigation pathname={Astro.url.pathname} />
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-body">
        <div class="footer-grid">
          <div class="footer-identity">
            <a href="/" class="wordmark"><span class="wordmark-text">Scientific Inference Lab</span></a>
            <p class="footer-affiliation">{site.footerAffiliation}</p>
          </div>
          <div class="footer-contact">
            <p class="footer-person"><strong>{pi.name}</strong><span>Principal Investigator</span></p>
            <a href={`mailto:${pi.email}`} class="text-link footer-email" data-footer-email><span><span class="email-part">{emailLocal}</span><wbr /><span class="email-part">@{emailDomain}</span></span><Mail size={16} aria-hidden="true" /></a>
            <nav aria-label="PI profiles">
              <ul class="footer-profiles">
                {profiles.map(profile => <li><a href={profile.href} class="text-link"><span>{profile.label}</span><ArrowUpRight size={16} aria-hidden="true" /></a></li>)}
              </ul>
            </nav>
          </div>
        </div>
        <div class="footer-bottom">
          <a href={site.universityUrl} class="footer-university" aria-label="Pusan National University"><img src={university.src} width={university.width} height={university.height} alt="Pusan National University" loading="lazy" /></a>
          <div class="footer-meta"><span>&copy; {new Date().getFullYear()} Scientific Inference Lab</span><span>Yangsan, Republic of Korea</span></div>
        </div>
      </div>
    </footer>
  </body>
</html>
<style>
  .site-footer { background: var(--color-canvas); margin-top: 5rem; padding-block: 2.5rem 1.5rem; }
  .footer-body { container: footer-layout / inline-size; }
  .footer-grid { display: grid; grid-template-columns: minmax(0,1fr); gap: 2rem; align-items: start; }
  .footer-identity,.footer-contact { min-width: 0; }
  .footer-affiliation { margin-top: .75rem; font-size: .875rem; line-height: 1.5; text-wrap: pretty; }
  .footer-person { display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem .75rem; padding-top: .625rem; }
  .footer-person strong { font-size: 1rem; font-weight: 600; color: var(--color-ink); }
  .footer-person > span { font-size: .875rem; color: var(--color-muted); }
  .footer-profiles { display: flex; flex-wrap: wrap; gap: .25rem 1.5rem; margin-top: .25rem; }
  .footer-profiles li { min-width: 0; }
  .footer-profiles a { min-height: 44px; max-width: 100%; gap: .5rem; font-size: 1rem; }
  .footer-profiles a > span { min-width: 0; overflow-wrap: normal; }
  /* The address stays on one line whenever the column allows (body size, never
     shrunk). If it cannot fit, it breaks first at the <wbr> before "@", and
     inside a part only as a last resort, so neither the text nor the icon leaves
     the footer column. */
  .footer-email { max-width: 100%; margin-top: .5rem; overflow-wrap: anywhere; }
  .footer-email > span { min-width: 0; }
  .footer-bottom { display: grid; grid-template-columns: minmax(0,1fr); gap: 1.25rem 2rem; border-top: 1px solid var(--color-line); padding-top: 1.25rem; margin-top: 2rem; }
  .footer-university { display: inline-flex; align-items: center; min-height: 44px; max-width: 100%; justify-self: start; }
  .footer-university :global(img) { width: 160px; max-width: 100%; height: auto; }
  .footer-meta { display: flex; flex-direction: column; flex-wrap: wrap; gap: .25rem 1.5rem; min-width: 0; font-size: .875rem; line-height: 1.5; color: var(--color-muted); }
  @container footer-layout (min-width: 40rem) {
    .footer-grid { grid-template-columns: minmax(0,.95fr) minmax(0,1.05fr); gap: 4rem; }
    .footer-bottom { grid-template-columns: auto minmax(0,1fr); align-items: center; }
    .footer-meta { flex-direction: row; justify-content: space-between; align-items: center; }
  }
  @media (max-width: 47.99rem) { .site-footer { margin-top: 3rem; } }
</style>
