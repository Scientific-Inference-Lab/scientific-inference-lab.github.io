---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactPanel from '../components/ContactPanel.astro';
import { site } from '../lib/data/lab';
import { loadContent } from '../lib/content';
import university from '../lib/assets/university.svg';
const { pi } = await loadContent();
---
<SiteLayout title="Contact" description="Contact the Scientific Inference Lab for research opportunities and collaboration.">
  <PageHeader eyebrow="Research inquiries" title="Contact" description="Contact the lab about research opportunities and collaboration." />
  <ContactPanel {pi} {site} {university} />
</SiteLayout>
