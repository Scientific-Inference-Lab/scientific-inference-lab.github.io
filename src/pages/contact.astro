---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { pageDescriptions } from '../lib/data/page-copy';
import ContactPanel from '../components/ContactPanel.astro';
import { site } from '../lib/data/lab';
import { loadContent } from '../lib/content';
import university from '../lib/assets/university.svg';
const { pi } = await loadContent();
---
<SiteLayout title="Contact" description={pageDescriptions.contact}>
  <PageHeader eyebrow="Research inquiries" title="Contact" />
  <ContactPanel {pi} {site} {university} />
</SiteLayout>
