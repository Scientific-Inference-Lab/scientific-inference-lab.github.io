---
import { ArrowRight } from '@lucide/svelte';
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeResearch from '../components/HomeResearch.svelte';
import { loadContent } from '../lib/content';
import { site, joinUs } from '../lib/data/lab';
const { programs, news } = await loadContent();
const topics = programs.map(({ id, title, summary }) => ({ id, title, summary }));
---
<SiteLayout title={site.name}>
  <header class="wrap home-intro" aria-labelledby="lab-heading">
    <div class="intro-layout">
    <div class="intro-copy">
      <h1 id="lab-heading" class="home-title">{site.identity}</h1>
      <p class="home-introduction">{site.intro}</p>
      <div class="home-actions">
        <a class="button" href="/research/">Explore research <ArrowRight size={18} aria-hidden="true" /></a>
        <a class="button-secondary" href="/people/">Meet the PI <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </div>
    </div>
  </header>

  <HomeResearch programs={topics} />

  <section class="news-band" aria-labelledby="news-heading">
    <div class="wrap news-layout">
      <div class="news-heading"><h2 id="news-heading">Latest news</h2></div>
      <div class="news-list">
        {news.map(item => <article class="news-item"><div class="news-meta"><time datetime={item.date}>{new Date(`${item.date}-01T00:00:00Z`).toLocaleDateString('en-US',{ month:'short', year:'numeric',timeZone:'UTC' })}</time><span>{item.category}</span></div><div><h3>{item.publicationId ? <a href={`/publications/#${item.publicationId}`}>{item.title}<ArrowRight size={17} /></a> : item.title}</h3><p>{item.text}</p></div></article>)}
      </div>
    </div>
  </section>

  <section class="wrap inquiry" aria-labelledby="inquiry-heading">
    <div class="inquiry-layout">
      <div><h2 id="inquiry-heading">Research opportunities &amp; collaboration</h2><p>{joinUs.body}</p></div>
      <a class="button" href="/contact/">Get in touch <ArrowRight size={18} aria-hidden="true" /></a>
    </div>
  </section>
</SiteLayout>
<style>
  .home-intro { container: home-intro / inline-size; padding-block: 2.75rem 0; }
  .intro-layout { display: grid; grid-template-columns: minmax(0,1fr); align-items: start; gap: 2rem; }
  .intro-copy { min-width: 0; }
  /* Balanced lines: the full-width title would otherwise end a line after the
     hyphen of "decision-making". No phrase-level break or nowrap is forced. */
  .home-title { font-size: 2.125rem; line-height: 1.12; text-wrap: balance; }
  /* Without the former photo column the title spans the page width; only the
     paragraph keeps a reading measure. */
  .home-introduction { max-width: 46rem; margin-top: 1.25rem; font-size: 1.0625rem; line-height: 1.65; text-wrap: pretty; }
  .home-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.5rem; margin-top: 1.5rem; }
  .home-actions a { max-width: 100%; }
  .news-band { container: home-news / inline-size; border-block: 1px solid var(--color-line); padding-block: 3.5rem; }
  .news-layout { display: grid; grid-template-columns: minmax(0,1fr); gap: 2rem; }
  .news-heading h2 { font-size: 2rem; line-height: 1.2; }
  .news-heading > p { margin-top: .875rem; color: var(--color-muted); }
  .news-list { min-width: 0; }
  .news-item { display: grid; grid-template-columns: minmax(0,1fr); gap: .625rem; padding-block: 1.25rem; border-bottom: 1px solid var(--color-line); }
  .news-item:first-child { padding-top: 0; }
  .news-item:last-child { border: 0; padding-bottom: 0; }
  .news-meta { display: flex; flex-wrap: wrap; gap: .375rem .75rem; font-size: .8125rem; color: var(--color-muted); }
  .news-meta span { font-weight: 600; }
  .news-item h3 { font-size: 1.125rem; line-height: 1.4; }
  .news-item a { display: block; min-height: 44px; padding-block: .375rem; }
  .news-item a :global(svg) { display: inline-block; vertical-align: middle; margin-left: .35rem; color: var(--color-action); }
  .news-item a:hover { color: var(--color-action); text-decoration: underline; text-underline-offset: .2em; }
  .news-item p { margin-top: .375rem; max-width: 68ch; line-height: 1.65; }
  .inquiry { container: home-inquiry / inline-size; padding-top: 3.5rem; }
  .inquiry-layout { display: grid; grid-template-columns: minmax(0,1fr); gap: 1.5rem; align-items: center; }
  .inquiry h2 { font-size: 1.75rem; line-height: 1.25; }
  .inquiry p { margin-top: 1rem; max-width: 70ch; text-wrap: pretty; }
  .inquiry .button { justify-self: start; max-width: 100%; }
  @container home-intro (min-width: 44rem) {
    .home-title { font-size: 2.75rem; }
  }
  @container home-intro (min-width: 60rem) {
    .home-introduction { font-size: 1.125rem; }
  }
  @container home-intro (min-width: 76rem) {
    .home-title { font-size: 3.5rem; }
  }
  @container home-news (min-width: 60rem) {
    .news-layout { grid-template-columns: minmax(0,.8fr) minmax(0,2fr); gap: 4rem; }
    .news-heading { grid-column: 1; }
    .news-list { grid-column: 2; grid-row: 1; }
    .news-item { grid-template-columns: 7rem minmax(0,1fr); gap: 1.5rem; }
    .news-meta { display: block; padding-top: .25rem; }
    .news-meta time,.news-meta span { display: block; }
    .news-meta span { margin-top: .25rem; }
  }
  @container home-inquiry (min-width: 48rem) {
    .inquiry-layout { grid-template-columns: minmax(0,1fr) auto; gap: 4rem; }
  }
  @container home-intro (max-width: 18rem) {
    .home-title { font-size: 1.875rem; }
  }
  @container home-intro (max-width: 12rem) { .home-title { font-size: 1.25rem; } }
  @container home-inquiry (max-width: 18rem) { .inquiry h2 { font-size: 1.25rem; } }
  @media (max-width: 47.99rem) {
    .home-intro { padding-block: 1.75rem 0; }
    .intro-layout { gap: 1.5rem; }
    .news-band { padding-block: 2.5rem; }
    .inquiry { padding-top: 2.5rem; }
  }
</style>
