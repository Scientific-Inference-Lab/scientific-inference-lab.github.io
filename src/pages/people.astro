---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PeopleProfile from '../components/PeopleProfile.svelte';
import { site } from '../lib/data/lab';
import { loadContent } from '../lib/content';
import { responsiveImage } from '../lib/media';
import photo from '../lib/assets/pi.jpg';
const { pi, publications } = await loadContent();
const portrait = await responsiveImage(photo, pi.photoAlt, '(min-width: 1344px) 486px, (min-width: 768px) calc(40vw - 51.2px), 224px');
const selectedRecognition = [
  { alias: 'evidence-standards', label: 'Sole-authored position paper' },
  { alias: 'multi-view', label: 'Best Paper Award' },
  { alias: 'stable-neural-sdes', label: 'Spotlight' },
].map(({ alias, label }) => {
  const publication = publications.find(item => item.id === alias || item.aliases?.includes(alias));
  if (!publication) throw new Error(`Missing selected recognition publication: ${alias}`);
  return { id: publication.id, venue: publication.venue, year: publication.year, label };
});
---
<SiteLayout title="People" description="YongKyung Oh, principal investigator of the Scientific Inference Lab at Pusan National University." image={portrait.src}>
  <PageHeader eyebrow="Lab leadership" title="People" />
  <PeopleProfile {pi} {site} {portrait} recognition={selectedRecognition} />
</SiteLayout>
