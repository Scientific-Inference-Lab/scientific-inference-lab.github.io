---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { pageDescriptions } from '../lib/data/page-copy';
import PublicationLibrary from '../components/PublicationLibrary.svelte';
import { ArrowUpRight } from '@lucide/svelte';
import { pi } from '../lib/data/lab';
import { loadContent } from '../lib/content';
const { publications } = await loadContent();
---
<SiteLayout title="Publications" description={pageDescriptions.publications}>
  <PageHeader eyebrow="Research record" title="Publications" description={pageDescriptions.publications}>
    <a slot="action" href={pi.links.scholar} class="text-link">Google Scholar<ArrowUpRight size={16} aria-hidden="true" /></a>
  </PageHeader>
  <PublicationLibrary {publications} client:load />
</SiteLayout>
