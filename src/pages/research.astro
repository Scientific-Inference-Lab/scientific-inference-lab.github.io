---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ResearchExplorer from '../components/ResearchExplorer.svelte';
import { loadContent } from '../lib/content';
const { programs, publications } = await loadContent();
const entries = programs.map(program => ({
  ...program,
  papers: program.related.map(r => {
    const paper = publications.find(p => p.id === r.id)!;
    return { id: paper.id, title: paper.title, venue: paper.venue, year: paper.year, recognition: paper.recognition, context: r.label };
  }),
}));
---
<SiteLayout title="Research" description="Machine learning for scientific discovery and informed decisions: AI for Science, continuous-time modeling, evidence-centered AI, and industrial AI and decision-making.">
  <PageHeader eyebrow="Questions, methods and evidence" title="Research" description="We connect scientific knowledge, data, and simulation to understand complex systems, and examine the assumptions, uncertainty, and evidence behind our conclusions." />
  <ResearchExplorer programs={entries} />
</SiteLayout>
