---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PiProfile from '../../components/PiProfile.astro';
import Recognition from '../../components/Recognition.astro';
import { site } from '../../lib/data/lab';
import { loadContent } from '../../lib/content';
import { responsiveImage } from '../../lib/media';
import photo from '../../lib/assets/pi.jpg';
const { pi, publications } = await loadContent();
const portrait = await responsiveImage(photo, pi.photoAlt, '(min-width: 1344px) 486px, (min-width: 768px) calc(40vw - 51.2px), 224px');
const selectedRecognition = [
  { alias: 'evidence-standards', label: 'Sole-authored position paper' },
  { alias: 'multi-view', label: 'Best Paper Award' },
  { alias: 'stable-neural-sdes', label: 'Spotlight' },
].map(({ alias, label }) => {
  const publication = publications.find(item => item.id === alias || item.aliases?.includes(alias));
  if (!publication) throw new Error(`Missing selected recognition publication: ${alias}`);
  return { id: publication.id, venue: publication.venue, year: publication.year, label };
});
// A research award links to its paper only on an exact (case-insensitive) title match.
const awardLinks = Object.fromEntries(pi.awards.flatMap(award => {
  const publication = publications.find(item => item.title.toLowerCase() === award.paper.toLowerCase());
  return publication ? [[award.cvLabel, publication.id]] : [];
}));
---
<SiteLayout title={pi.name} description="YongKyung Oh, principal investigator of the Scientific Inference Lab at Pusan National University." image={portrait.src}>
  <PageHeader eyebrow="Principal Investigator" title={pi.name} titleId="pi-name" />
  <PiProfile {pi} {site} {portrait} />
  <Recognition {pi} recognition={selectedRecognition} {awardLinks} />
</SiteLayout>
